{
  "name": "dailycart",
  "version": "1.0.0",
  "private": true,
  "description": "Website thương mại điện tử và đặt hàng trực tuyến DailyCart",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "npm install --prefix server && npm install --prefix client",
    "setup": "npm run setup --prefix server",
    "db:init": "npm run db:init --prefix server",
    "db:reset": "npm run db:reset --prefix server",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client"
  }
}
